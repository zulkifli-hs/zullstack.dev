# Copy to .env.local and fill in. .env.local is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/zullstack
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/zullstack?retryWrites=true&w=majority
MONGODB_URI=

# Better Auth (Phase 2) opens a transaction when it is given a MongoClient.
# A standalone mongod (no replica set) cannot do transactions — set this to
# false for a plain local install. Atlas clusters are replica sets, so leave
# it true there.
MONGODB_TRANSACTIONS=true

# ── Auth (Phase 2) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Object storage (Phase 2) ─────────────────────────────────────────────────
# API secret is server-only. Never prefix it with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed preset — an unsigned preset lets anyone upload to your account.
CLOUDINARY_UPLOAD_PRESET=zullstack_signed

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics ────────────────────────────────────────────────────────────────
# Leave UNSET locally. Visitor analytics is off unless this is "true" or the
# deployment is a Vercel production one (VERCEL_ENV=production) — so local dev,
# local `next build && next start`, and preview deploys all record nothing.
#
# Deliberately not keyed on NODE_ENV: `next build && next start` sets
# NODE_ENV=production, and .env.local points at the live database, so a
# NODE_ENV gate would write local browsing straight into production data.
#
# Set to "true" only when testing collection against a scratch MONGODB_URI.
# Set to "false" to force it off on a production deploy.
ANALYTICS_ENABLED=
